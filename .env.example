HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
API_BASE_URL=/api
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
# Comma-separated list of allowed CORS origins. No wildcard "*" — list
# every origin the frontend is actually served from (default Vite port
# 5173, plus 3000 if you run the dev server with --port 3000).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# RS256 keypair, base64-encoded (PEM contains newlines .env handles
# poorly unescaped). Generate a dev pair with:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization; import base64; k=rsa.generate_private_key(public_exponent=65537,key_size=2048); print('JWT_PRIVATE_KEY_B64='+base64.b64encode(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())).decode()); print('JWT_PUBLIC_KEY_B64='+base64.b64encode(k.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo)).decode())"
# Secret — NEVER commit a real private key value here. Production should
# source these from Key Vault, not a .env file.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Secure=True (the default) requires HTTPS for the refresh cookie. Local
# dev over plain http://localhost must explicitly set this to false, or
# the browser will silently drop the cookie and /refresh will fail.
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./app/data/app.db
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=devpassword123

# --- SSO (Microsoft Entra ID, OIDC) ---
# Not secret — safe to share/commit as placeholders. Get real values from
# whoever created the Azure App Registration.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Secret — NEVER commit a real value here. Only set this in your local,
# gitignored .env file.
AZURE_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the App Registration.
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/saml/acs
