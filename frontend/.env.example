# The path/URL the frontend's axios client calls for API requests. Relative
# path in local dev (proxied by Vite, see VITE_API_PROXY_TARGET below); set
# to the real backend URL once deployed (e.g. https://your-app.azurewebsites.net/api).
VITE_API_BASE_URL=/api
# Only used by vite.config.ts's dev-server proxy — where "/api" requests
# actually get forwarded to during local development. Not used in a
# production build at all (Static Web Apps doesn't run this dev proxy).
VITE_API_PROXY_TARGET=http://localhost:8000
